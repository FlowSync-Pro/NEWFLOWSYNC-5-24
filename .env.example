# FlowSync — Phase 2 environment variables.
# Copy to .env.local for local dev, and add the same keys in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# --- Database (Vercel Postgres / Neon) ---
# Neon (via the Vercel integration) provides both automatically:
#   DATABASE_URL          = pooled connection (used by the app at runtime)
#   DATABASE_URL_UNPOOLED = direct connection (used by `prisma migrate`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Auth.js (NextAuth) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# --- Vercel Blob (driver document storage) ---
BLOB_READ_WRITE_TOKEN=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend (transactional email) ---
RESEND_API_KEY=
# Must be on a domain you've verified in Resend, e.g. hello@mail.flowsyncdriver.com
RESEND_FROM_EMAIL=

# --- Google Maps (optional) ---
# Public key for inline route maps on trips (enable Maps Embed API; restrict by HTTP referrer).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Server key for auto-mileage (enable Distance Matrix API). Falls back to the public key.
GOOGLE_MAPS_API_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=https://flowsyncdriver.com
# Comma-separated emails that can access /admin (driver verification).
ADMIN_EMAILS=

# --- Meta / Facebook ads (optional) ---
# Your Meta Pixel ID — defaults to 2070476707153491 when unset.
NEXT_PUBLIC_META_PIXEL_ID=
# Meta domain-verification code (Business Settings → Brand Safety → Domains).
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=
# Optional: Facebook App ID — only silences the fb:app_id share-debugger warning.
NEXT_PUBLIC_FB_APP_ID=

# --- Google Tag Manager (optional) ---
# Container ID — defaults to GTM-NZGX62XL when unset.
NEXT_PUBLIC_GTM_ID=

# --- Onboarding: founder Loom + driver community (optional) ---
# 60-second welcome video shown at the top of /account. Hidden when unset.
# Paste a Loom share URL (e.g. https://www.loom.com/share/abc123…).
NEXT_PUBLIC_FOUNDER_LOOM_URL=
# Driver community invite link shown on /account. Hidden when unset.
# Must be https://t.me/… (Telegram); other hosts are ignored.
NEXT_PUBLIC_TELEGRAM_INVITE_URL=
